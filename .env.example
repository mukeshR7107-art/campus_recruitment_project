# ─────────────────────────────────────────────────────────────────────────────
# Campus Recruitment Management System (CRMS) - Environment Template
#
# Copy this file to `.env` and provide your specific credentials.
# NEVER commit your `.env` with actual secrets into version control!
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase Public Connection ───────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ── Rate Limiting Thresholds (Configurable Overrides) ────────────────────────
# Authentication window in milliseconds (default: 900000 = 15 minutes)
VITE_RATE_LIMIT_AUTH_WINDOW_MS=900000
# Failed attempts before exponential backoff triggers (default: 3)
VITE_RATE_LIMIT_AUTH_MAX_ATTEMPTS=3
# Initial backoff delay in seconds (default: 2)
VITE_RATE_LIMIT_AUTH_BASE_BACKOFF_SEC=2
# Maximum backoff delay in seconds (default: 60)
VITE_RATE_LIMIT_AUTH_MAX_BACKOFF_SEC=60

# Public requests limit per 1-minute window (default: 60)
VITE_RATE_LIMIT_PUBLIC_MAX_REQ=60
# Authenticated user requests limit per 1-minute window (default: 120)
VITE_RATE_LIMIT_USER_MAX_REQ=120
# Maximum file uploads allowed per 10-minute window (default: 6)
VITE_RATE_LIMIT_UPLOAD_MAX=6

# ── File Upload Safety Constraints ───────────────────────────────────────────
# Maximum file size in bytes (default: 5242880 = 5MB)
VITE_MAX_UPLOAD_SIZE_BYTES=5242880
